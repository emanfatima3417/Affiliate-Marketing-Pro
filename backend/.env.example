NODE_ENV=development
PORT=5000

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/affiliate_marketplace_pro

# JWT
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# Frontend
CLIENT_URL=http://localhost:3000

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Stripe
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxx
# Get this from the Stripe CLI (`stripe listen --forward-to localhost:5000/api/webhooks/stripe`)
# or your Stripe Dashboard webhook endpoint settings. Required for payment
# status to reconcile if a customer closes the tab right after paying.
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx

# Default commission percent (used if a product doesn't set its own)
DEFAULT_COMMISSION_PERCENT=20

# Email (SMTP) - used for password reset emails. If left unset, reset links
# are logged to the console instead so the flow still works in local dev.
# Any SMTP provider works (Gmail app password, SendGrid, Mailgun, Postmark,
# Amazon SES, etc). Example values for a generic provider:
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_FROM="Affiliate Marketplace Pro <no-reply@yourdomain.com>"

# reCAPTCHA v3 (optional) - adds bot-scoring on top of the honeypot field and
# rate limiting already applied to registration. Leave unset to skip; every
# registration is then allowed through the honeypot/rate-limit checks alone.
# Get keys at https://www.google.com/recaptcha/admin (choose v3).
RECAPTCHA_SECRET_KEY=
